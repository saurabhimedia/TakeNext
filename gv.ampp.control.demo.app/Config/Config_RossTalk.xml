<configuration>
<!--   `TIME_BETWEEN_COMMANDS`parameter defines the minimum time interval (in milliseconds) between consecutive cue tone actions. If a new action is detected within this duration, it will be ignored to prevent unintended rapid triggers.  -->
<ConfigEntry Key="TIME_BETWEEN_COMMANDS" Value="2000"/>
<!--   value should be in milliseconds   -->
<!--  ConfigEntry Key="Working Directory" Value=".\"/  -->
<ConfigEntry Key="Application Name" Value="IP_Trigger_Rosstalk"/>
<!--   Applicaiton name, same will be used for logging file name   -->
<ConfigEntry Key="LogGoLiveTimeStamp" Value="Yes"/>
<!--   if Enabled will log the timestamps of commands sent/Response received -->
<ConfigEntry Key="Switcher IP" Value="192.168.201.39"/>
<ConfigEntry Key="Switcher Port" Value="6100"/>
<ConfigEntry Key="NetworkId" Value="xyz"/>
<ConfigEntry Key="DELAY" Value="1000"/>
<ConfigEntry Key="LIVE-PCR1-IN" Value="GPI 1:1"/>
<ConfigEntry Key="LIVE-PCR1-OUT" Value="GPI 2:1"/>
<ConfigEntry Key="LIVE-PCR2-IN" Value="GPI 3:1"/>
<ConfigEntry Key="LIVE-PCR3-OUT" Value="GPI 4:1"/>
</configuration>
